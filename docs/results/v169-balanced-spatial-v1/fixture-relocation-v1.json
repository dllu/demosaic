    "path": "/home/dllu/proj/demosaic/.cache/relocate-v169-fixtures-v1.py",
    "sha256": "82230ec6753e542f95ce4721413ef45008cba0429198acb89643c3b2f507bb19",
    "text": "\"\"\"Relocate own immutable procedural fixtures to SSD,retaining logical paths/bytes.\"\"\"\nimport os,shutil,time\nfrom pathlib import Path\nfrom train_directional_bank_trial import read,ref,save\nrepo=Path('/home/dllu/proj/demosaic');root=repo/'.cache/quality-20261107/V169-balanced-spatial-v3'\ndest=Path('/mnt/external/demosaic/cache-relocations/20261107-v169-mesh-fixtures-v1');assert not dest.exists()\nexpected={c['arrays']['path']:c['arrays'] for c in read(read(root/'plan-v1.json')['design']['path'])['observations'] if c['kind']=='mesh'}\nchosen=[];size=0\nfor name,binding in sorted(expected.items()):\n p=Path(name)\n if p.is_symlink():continue\n assert p.is_relative_to(repo/'.cache/quality-20261103/supported-amplitude-v1/prospective-v1/inputs')\n chosen.append((p,binding));size+=p.stat().st_size\n if size>=.75*2**30:break\nassert .75*2**30<=size<.78*2**30\nassert shutil.disk_usage('/mnt/external').free>116.5*2**30+size+read(root/'plan-v1.json')['projected_new_array_bytes']\ndest.mkdir(parents=True);rows=[];before={'local':shutil.disk_usage(repo).free,'external':shutil.disk_usage('/mnt/external').free}\nwith (root/'fixture-relocation-journal-v1.jsonl').open('x') as journal:\n for source,binding in chosen:\n  assert ref(source)==binding and not source.is_symlink();target=dest/source.name;assert not target.exists()\n  shutil.copy2(source,target);assert ref(target)['sha256']==binding['sha256']\n  link=source.with_name(source.name+'.v169-relocation-link');assert not link.exists();link.symlink_to(target)\n  os.replace(link,source);assert source.is_symlink() and ref(source)==binding\n  row={'logical_path_unchanged':binding,'physical_copy':ref(target),'bytes':target.stat().st_size};rows.append(row)\n  journal.write(__import__('json').dumps(row)+'\\n');journal.flush()\nfor row in rows:assert ref(row['logical_path_unchanged']['path'])==row['logical_path_unchanged']\nsave(root/'fixture-relocation-v1.json',{'status':'completed-byte-exact-procedural-fixture-relocation-with-original-path-links',\n 'recorded_unix_UTC':time.time(),'rows':rows,'files':len(rows),'bytes':size,'before_free_bytes':before,\n 'after_free_bytes':{'local':shutil.disk_usage(repo).free,'external':shutil.disk_usage('/mnt/external').free},\n 'source':dict(ref(Path(__file__)),text=Path(__file__).read_text()),\n 'scope':'Only this project\\'s own derived procedural mesh NPZ fixtures move to fast SSD. Every copied file matches its original recorded SHA256 before atomic replacement by a symlink at the unchanged logical path. Original receipt bytes and all fixture bytes remain intact. No RAF,JPEG,original media,source sampler,model or noise draw changes. This frees internal storage without lowering the56GiB guard;external116GiB reserve and future review projection remain satisfied.'})\nprint('Relocated',len(rows),'own fixtures;',size/2**30,'GiB;free local',shutil.disk_usage(repo).free/2**30,flush=True)\n"
  },
  "scope": "Only this project's own derived procedural mesh NPZ fixtures move to fast SSD. Every copied file matches its original recorded SHA256 before atomic replacement by a symlink at the unchanged logical path. Original receipt bytes and all fixture bytes remain intact. No RAF,JPEG,original media,source sampler,model or noise draw changes. This frees internal storage without lowering the56GiB guard;external116GiB reserve and future review projection remain satisfied."
