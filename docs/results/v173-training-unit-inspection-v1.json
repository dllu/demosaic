  "source": {
    "path": "/home/dllu/proj/demosaic/.cache/inspect-v173-training-units-v1.py",
    "sha256": "b313e8dfb3e178f5237f7366832a715d7caeb799f1a67399713515d51f210518",
    "text": "\"\"\"Measure existing loss weighting on preselected cached training examples;no inference.\"\"\"\nfrom pathlib import Path\nimport json,numpy as np\nfrom train_directional_bank_trial import read,ref,save\nrepo=Path('/home/dllu/proj/demosaic');root=repo/'.cache/quality-20261107/V173-local-reconstruction-v1';root.mkdir(exist_ok=True)\nplan=read(repo/'.cache/quality-20261107/V172-local-noise-matching-v1/plan-v1.json');cache=read(plan['cache']['path']);selected=[];counts={}\nfor row in cache['batches']:\n domain=row['metadata']['domain']\n if row['metadata']['noise']['shot']<=0 or counts.get(domain,0)>=2:continue\n selected.append(row);counts[domain]=counts.get(domain,0)+1\nassert len(selected)==10\nresults=[]\nfor row in selected:\n binding=row['arrays'];assert ref(binding['path'])==binding;a=dict(np.load(binding['path']));v=np.maximum(a['variance'].astype(np.float64),0);t=a['target'].astype(np.float64)\n local=np.sqrt(v.mean(1,keepdims=True)).repeat(2,-2).repeat(2,-1);local=np.maximum(local,16/65535);global_unit=np.maximum(np.sqrt(v.mean((1,2,3),keepdims=True)),16/65535);ratio=global_unit/local\n for i in range(len(t)):\n  level=t[i].mean(0);dark=level<=np.quantile(level,.25);bright=level>=np.quantile(level,.75)\n  results.append(dict(step=row['step'],domain=row['metadata']['domain'],image=i,input=binding,ratio_percentiles=np.percentile(ratio[i],[0,25,50,75,100]).tolist(),dark_quartile_mean_ratio=float(ratio[i,0][dark].mean()),bright_quartile_mean_ratio=float(ratio[i,0][bright].mean()),global_unit_DN16=float(global_unit[i,0,0,0]*65535),local_unit_DN16_percentiles=np.percentile(local[i]*65535,[0,25,50,75,100]).tolist()))\nout=root/'training-unit-inspection-v1.json';assert not out.exists();save(out,dict(status='measured-preselected-training-loss-unit-ratios',selection='First2 positive-shot rows of each of5 domains in original1000-row order;10batches/40images,chosen before ratio calculation.',cache=plan['cache'],source_plan=ref(repo/'.cache/quality-20261107/V172-local-noise-matching-v1/plan-v1.json'),rows=results,new_neural_forwards=0,new_source_noise_draws=0,source=dict(ref(__file__),text=Path(__file__).read_text()),scope='Global/local units are empirical loss weights,not calibrated RGB covariance;no new model,quality output or gradient-cause attribution.'))\nfor domain in counts:\n x=[r for r in results if r['domain']==domain];print(domain,'dark ratio',round(float(np.mean([r['dark_quartile_mean_ratio'] for r in x])),3),'bright',round(float(np.mean([r['bright_quartile_mean_ratio'] for r in x])),3),'range',round(min(r['ratio_percentiles'][0] for r in x),3),round(max(r['ratio_percentiles'][-1] for r in x),3))\n"
  },
  "scope": "Global/local units are empirical loss weights,not calibrated RGB covariance;no new model,quality output or gradient-cause attribution."
}
