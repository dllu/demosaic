    "source_text": "\"\"\"Record frozen V198 quality preparation and real registered owner observations.\"\"\"\nimport json\nimport shutil\nimport sys\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\nfrom zoneinfo import ZoneInfo\n\nfrom directional_trial_protocol import REPO, guard, read, ref, save\nfrom phase_admission_protocol import owner_live\n\nroot = REPO / '.cache/quality-20261108/V198-cfa-innovation-wave-trial-v1'\nplan = read(root / 'plan-v1.json')\nseal = read(root / 'review-source-v1.json')\ncontroller = read(root / 'quality-controller-v1/plan-v1.json')\nfor data in [plan, seal, controller]:\n    guard(data)\nmetric = read(root / 'metric-preflight-v1.json')\nlayout = read(root / 'input-layout-preflight-v1.json')\ndisplay = read(root / 'reference-display-preflight-v1.json')\nassert metric['cases'] == 36 and metric['numeric_scalars_within_1e-10'] == 255\nassert metric['new_module_forwards'] == 0 and not metric['CUDA_initialized']\nassert sum(layout['color_layout_counts'].values()) == 822 and layout['target_arrays_read'] == 0\nassert display['exact_GT_panels_checked'] == 64 and display['native_RGB_channels_checked'] == 4915200\nassert display['new_images_written'] == display['new_neural_forwards'] == 0\nassert '13 passed' in (REPO / '.cache/v198-evidence-CPU-tests-v1.log').read_text()\nprevious = read(REPO / 'docs/results/v198-cfa-innovation-prepared-v1.json')\nfor name,digest in previous['all105_current_neural_hashes'].items():\n    assert ref(REPO / 'src/demosaic' / name)['sha256'] == digest\nowners = {}\nfor label,filename in [('training-controller', 'training-controller-v1/watch-launch-v1.json'), ('training', 'CFA-launch-v1.json'), ('quality-controller', 'quality-controller-v1/watch-launch-v1.json'), ('feature-bridge', 'bridge-launch-v1.json'), ('review', 'review-launch-v1.json')]:\n    path = root / filename\n    if path.exists():\n        launch = read(path)\n        owners[label] = {'launch': ref(path), 'owner': launch['owner'], 'live_at_observation': owner_live(launch['owner'])}\nassert owners['quality-controller']['live_at_observation']\nfor filename in ['CFA-train-failure-v1.json', 'training-controller-v1/watch-failure-v1.json', 'quality-controller-v1/watch-failure-v1.json', 'bridge-failure-v1.json', 'review-failure-v1.json']:\n    assert not (root / filename).exists(),filename\npublic = REPO / 'docs/results/v198-cfa-innovation-review-prepared-v1'\npublic.mkdir()\nitems = [\n    ('review-source-v1.json', root / 'review-source-v1.json'),\n    ('measurement-record-CPU-tests-v1.log', REPO / '.cache/v198-evidence-CPU-tests-v1.log'),\n    ('metric-preflight-v1.json', root / 'metric-preflight-v1.json'),\n    ('metric-preflight-v1.log', root / 'metric-preflight-v1.log'),\n    ('input-layout-preflight-v1.json', root / 'input-layout-preflight-v1.json'),\n    ('reference-display-preflight-v1.json', root / 'reference-display-preflight-v1.json'),\n    ('display-layout-preflight-v1.log', root / 'display-layout-preflight-v1.log'),\n    ('quality-controller-plan-v1.json', root / 'quality-controller-v1/plan-v1.json'),\n    ('quality-controller-launch-v1.json', root / 'quality-controller-v1/watch-launch-v1.json'),\n]\ncopies = []\nfor name,source in items:\n    target = public / name\n    assert not target.exists()\n    shutil.copyfile(source,target)\n    assert ref(source)['sha256'] == ref(target)['sha256']\n    copies.append({'public':ref(target),'original':ref(source),'byte_exact_copy':True})\nassert 'torch' not in sys.modules\nvalue = {\n    'status': 'frozen-CPU-preflights-pass-registered-quality-controller-launched',\n    'created_unix_UTC': time.time(),\n    'observed_local': datetime.now(ZoneInfo('America/Los_Angeles')).isoformat(),\n    'training_plan': ref(root / 'plan-v1.json'),\n    'review_source': ref(root / 'review-source-v1.json'),\n    'controller_plan': ref(root / 'quality-controller-v1/plan-v1.json'),\n    'actual_owner_observations': owners,\n    'training_status_at_observation': read(root / 'CFA-status-v1.json'),\n    'quality_controller_status_at_observation': read(root / 'quality-controller-v1/watch-status-v1.json'),\n    'training_audit_at_observation': ref(root / 'training-audit-v1.json') if (root / 'training-audit-v1.json').exists() else None,\n    'new_measurement_record_CPU_tests_passed': 13,\n    'CPU_metric_native_contexts': 36, 'CPU_metric_numeric_scalars': 255,\n    'CPU_metric_absolute_tolerance': 1e-10,\n    'cached_CFA_layouts_checked': 822,\n    'earlier_exact_GT_native_panels_checked': 64,\n    'earlier_exact_GT_native_RGB_channels_checked': 4915200,\n    'all105_neural_hashes_unchanged': previous['all105_current_neural_hashes'],\n    'planned_endpoints': ['raw','EMA'], 'planned_quality_cases_per_endpoint':822,\n    'planned_component_counts': seal['quality_context']['expected_quality_counts'],\n    'planned_actual_CUDA_feature_only_contexts': 4,\n    'planned_feature_bridge_neural_forwards': 0,\n    'planned_native_RGB_arrays':72, 'planned_native_wave_arrays':72,\n    'planned_comparison_methods':9,'planned_comparison_metric_rows':7398,\n    'planned_native_figures':60,'planned_native_triplets':12,\n    'planned_strict_CPU_standalone_exports':2,\n    'preparation_and_CPU_preflight_new_neural_forwards':0,\n    'preparation_new_parent_DINO_forwards':0,'preparation_new_source_noise_draws':0,\n    'external_bytes_written':0,'total_trial_local_budget_bytes':2 * 2**30,\n    'minimum_local_free_bytes':40 * 2**30,\n    'copies': copies,\n    'recorder': {**ref(__file__), 'source_text':Path(__file__).read_text()},\n    'scope': 'Source-bound preparation for complete two-endpoint quality pipeline. Follow original training-controller PID/create-time and full CPU training audit. Run registered input-only CUDA feature bridge with neural calls disabled,then predictions once. Finish independent stream/native/state/aggregate audit,compact current comparisons,exports,directional checks and native figures. Actual native viewing,browser pixel checks,interpretation and current useful-model documentation remain required. Snapshot never establishes trained quality. No newdata/noise,parentDINOinference,RAWdecode,original/datazaccess,externalwrites or repeatedscientificprefix. Existing evidence preserved.',\n}\nsave(REPO / 'docs/results/v198-cfa-innovation-review-prepared-v1.json',value)\nprint(json.dumps({k:value[k] for k in ['status','observed_local','training_status_at_observation','quality_controller_status_at_observation']}))\n"
