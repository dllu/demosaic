{
  "status": "pass-completed-copy-consolidation-all-paths-and-bytes-preserved",
  "created_local": "2026-11-08T05:29:43.887237-08:00",
  "plan": {
    "path": "/home/dllu/proj/demosaic/.cache/v185-completed-v184-native-storage-v1/plan-v1.json",
    "sha256": "922d83942a6d6912eebe65b3bbb52ead887f87cb3a5a1327454181544437432d"
  },
  "source": {
    "path": "/home/dllu/proj/demosaic/.cache/v185-completed-v184-native-storage-v1.py",
    "sha256": "f3b2f7b1c204c1f6525e6185f2593fac8937ed7e984e8ef7b27855f6f7eeba2c",
    "text": "\"\"\"Consolidate explicit completed native/receipt copies without changing bytes.\"\"\"\nimport collections\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport stat\nimport sys\nfrom datetime import datetime\nfrom zoneinfo import ZoneInfo\nimport psutil\n\nR=Path('/home/dllu/proj/demosaic')\nROOT=R/'.cache/v185-completed-v184-native-storage-v1'\nSPECS=[(184,'wave-readout')]\ndef read(p):return json.loads(Path(p).read_text())\ndef ref(p):\n p=Path(p).absolute()\n with p.open('rb') as f:h=hashlib.file_digest(f,'sha256').hexdigest()\n return {'path':str(p),'sha256':h}\ndef save(p,x):\n with p.open('x') as f:json.dump(x,f,indent=2,allow_nan=False);f.write('\\n')\ndef stamp():return datetime.now(ZoneInfo('America/Los_Angeles')).isoformat()\ndef observed(p):\n s=p.lstat();assert stat.S_ISREG(s.st_mode) and s.st_uid==os.getuid() and not p.is_symlink()\n return {n:getattr(s,'st_'+n) for n in ['dev','ino','size','mode','uid','gid','nlink','mtime_ns','ctime_ns','blocks']}\ndef terminal(o):\n try:p=psutil.Process(o['pid']);return p.create_time()!=o['created'] or p.status() in [psutil.STATUS_ZOMBIE,psutil.STATUS_DEAD]\n except psutil.NoSuchProcess:return True\ndef owners(root):\n out=[]\n for p in root.glob('*-launch-v1.json'):\n  d=read(p)\n  if 'owner' in d:\n   assert terminal(d['owner']),(p,d['owner'])\n   out.append({'launch':ref(p),'owner':d['owner'],'observed_terminal':True})\n return out\ndef free():return {p:shutil.disk_usage(p).free for p in [str(R),'/mnt/external']}\ndef plan():\n assert not ROOT.exists();ROOT.mkdir()\n all_owners=[];publications=[];native=[];receipts=[]\n for v,name in SPECS:\n  index=R/f'docs/results/v{v}-{name}-final-v1.json';d=read(index)\n  assert d['status'].startswith('completed-')\n  binding=d.get('plan',d['copies'].get('plan-v1.json',{}).get('original'))\n  assert binding and ref(binding['path'])==binding\n  p=Path(binding['path']);metadata=read(p);artifact=Path(metadata.get('artifacts',metadata.get('external','')))\n  assert p.parent.is_relative_to(R/'.cache/quality-20261107')\n  assert artifact.is_relative_to(R/'.cache/quality-20261107') or artifact.is_relative_to(Path('/mnt/external/demosaic/quality-20261107'))\n  checks=owners(p.parent);assert checks\n  all_owners+=checks;publications.append(ref(index))\n  for a in sorted((artifact/'native').rglob('*.npy')):\n   s=observed(a)\n   if s['size']>=512*1024:native.append({'binding':ref(a),'before':s})\n  for pair in d['copies'].values():\n   a,b=Path(pair['original']['path']),Path(pair['public']['path'])\n   if not a.is_relative_to(p.parent) or not b.is_relative_to(R/'docs/results'):continue\n   sa,sb=observed(a),observed(b)\n   if sa['size']<2**20 or sa['nlink']!=1 or (sa['dev'],sa['ino'])==(sb['dev'],sb['ino']):continue\n   assert sa['dev']==sb['dev'] and sa['mode']==sb['mode'] and sa['gid']==sb['gid']\n   assert ref(a)==pair['original'] and ref(b)==pair['public'] and pair['original']['sha256']==pair['public']['sha256']\n   receipts.append({'kind':'completed-receipt-copy','replace':pair['original'],'canonical':pair['public'],'before_replace':sa,'before_canonical':sb})\n groups=collections.defaultdict(list)\n for item in native:\n  s=item['before'];groups[(s['dev'],s['size'],s['mode'],s['gid'],item['binding']['sha256'])].append(item)\n rows=list(receipts)\n for group in groups.values():\n  by_inode={x['before']['ino']:x for x in group}\n  if len(by_inode)<2:continue\n  copies=list(by_inode.values());canonical=copies[0]\n  for item in copies[1:]:\n   if item['before']['nlink']!=1:continue\n   rows.append({'kind':'completed-native-array','replace':item['binding'],'canonical':canonical['binding'],\n                'before_replace':item['before'],'before_canonical':canonical['before']})\n assert rows\n allocated=collections.Counter()\n for row in rows:allocated[row['before_replace']['dev']]+=512*row['before_replace']['blocks']\n save(ROOT/'plan-v1.json',{'status':'read-only-full-hash-inventory-before-storage-change','created_local':stamp(),\n  'source':dict(ref(__file__),text=Path(__file__).read_text()),'publications':publications,\n  'terminal_launch_owners':all_owners,'native_arrays_hashed':len(native),'rows':rows,\n  'previous_duplicate_allocated_bytes_by_device':dict(allocated),'free_before':free(),\n  'scope':'Only native .npy outputs and explicit publication receipt copies in completed owned V184 native outputs only. Full hashes before mutation; all paths/bytes retained. No source, checkpoint, training input, original/capture/JPEG or dataz access. Existing inode metadata retained in inventory; replacements share canonical inode/mode/mtime. No earlier dedup is rerun. V185 source, probes and inputs are excluded.'})\n print('PLAN',len(rows),'replacement paths',len(native),'native arrays hashed','allocated GiB by device',{k:v/2**30 for k,v in allocated.items()},flush=True)\ndef apply():\n p=read(ROOT/'plan-v1.json');assert p['source']['sha256']==ref(__file__)['sha256']\n assert not (ROOT/'result-v1.json').exists()\n for item in p['terminal_launch_owners']:\n  assert ref(item['launch']['path'])==item['launch'] and terminal(item['owner'])\n for binding in p['publications']:assert ref(binding['path'])==binding\n for row in p['rows']:\n  a,b=Path(row['replace']['path']),Path(row['canonical']['path'])\n  # Other replacements may already have increased the canonical link count.\n  assert observed(a)==row['before_replace']\n  assert ref(a)==row['replace'] and ref(b)==row['canonical']\n  assert row['replace']['sha256']==row['canonical']['sha256']\n  temporary=a.with_name('.'+a.name+'.v185-copy-v1.tmp');assert not temporary.exists()\n  os.link(b,temporary);os.replace(temporary,a)\n  assert ref(a)==row['replace'] and ref(b)==row['canonical']\n  sa,sb=observed(a),observed(b);assert sa['dev']==sb['dev'] and sa['ino']==sb['ino']\n for binding in p['publications']:assert ref(binding['path'])==binding\n result={'status':'pass-completed-copy-consolidation-all-paths-and-bytes-preserved','created_local':stamp(),\n         'plan':ref(ROOT/'plan-v1.json'),'source':p['source'],'rows':p['rows'],\n         'terminal_launch_owners_checked':len(p['terminal_launch_owners']),\n         'replacement_paths':len(p['rows']),'previous_duplicate_allocated_bytes_by_device':p['previous_duplicate_allocated_bytes_by_device'],\n         'free_before':p['free_before'],'free_after':free(),'scope':p['scope']}\n save(ROOT/'result-v1.json',result)\n save(R/'docs/results/v185-completed-v184-native-storage-v1.json',result)\n print('PASS',len(p['rows']),'paths retained; free GiB',{k:v/2**30 for k,v in free().items()},flush=True)\nif __name__=='__main__':\n assert sys.argv[1] in ['plan','apply']\n plan() if sys.argv[1]=='plan' else apply()\n"
  },
