  "driver": "\"\"\"Reduce retained training speed and worker startup times without rerunning training.\"\"\"\nimport statistics\nimport subprocess\nfrom pathlib import Path\n\nfrom demosaic.experiments.artifacts import checked, read_json, reference, write_json\n\nROOT=Path(__file__).resolve().parent\nOUT=Path(\"docs/results/scene-full-epoch-v1\")\n\n\ndef main():\n    audit=reference(OUT/\"matched-010000-training.json\")\n    training=read_json(checked(audit))\n    results={}\n    for key,mode in ((\"none\",\"local\"),(\"spatial\",\"spatial\")):\n        a=training[\"arms\"][key]\n        phase=read_json(checked(a[\"phases\"][-1][\"receipt\"]))\n        init=[]\n        segments=[]\n        for record in phase[\"segments\"]:\n            mark=checked(record)\n            receipt=read_json(mark)\n            launch=reference(mark.parents[1]/\"launch.json\")\n            job=read_json(checked(launch))[\"child\"]\n            log=reference(mark.parent/\"train.jsonl\")\n            creation=int(subprocess.check_output([\"stat\",\"-c\",\"%W\",checked(log)],text=True))\n            if creation<=0:\n                raise RuntimeError(\"The filesystem has no usable creation time for worker logs\")\n            seconds=creation-job[\"created\"]\n            assert 0<seconds<900\n            init.append(seconds)\n            segments.append({\"start\":receipt[\"start_step_exclusive\"],\"stop\":receipt[\"steps\"],\n                             \"initialization_seconds\":seconds,\"launch\":launch,\"worker_log\":log,\n                             \"training_seconds\":receipt[\"seconds\"],\"data_seconds\":receipt[\"data_seconds\"]})\n        median=statistics.median(init)\n        results[mode]={\"retained_training_loop_seconds\":a[\"training_seconds\"],\n                       \"reader_and_CPU_fingerprint_seconds\":a[\"reader_and_cpu_fingerprints_seconds\"],\n                       \"checkpoint_write_seconds\":a[\"checkpoint_seconds\"],\n                       \"native_queries_per_retained_loop_second\":a[\"native_queries\"]/a[\"training_seconds\"],\n                       \"photos_per_retained_loop_second\":a[\"photos\"]/a[\"training_seconds\"],\n                       \"reader_share_of_retained_loop\":a[\"reader_and_cpu_fingerprints_seconds\"]/a[\"training_seconds\"],\n                       \"median_worker_initialization_latest_five_segments_seconds\":median,\"segments\":segments}\n    write_json(OUT/\"matched-010000-throughput.json\",{\"training\":audit,\"driver\":Path(__file__).read_text(),\n                \"method\":\"Worker startup is launch process creation to filesystem creation of train.jsonl. Clock resolution is one second.\",\n                \"scope\":\"Retained loops through 10k and the final five accepted segment starts. Attempt retries, waiting and evaluation are excluded.\",\n                \"results\":results})\n    print({k:{a:round(b,3)for a,b in v.items()if a!=\"segments\"}for k,v in results.items()})\n\n\nif __name__==\"__main__\":\n    main()\n",
