{
  "script": "\"\"\"Resample eight matched photo IDs for the 5k preview and checkpoint differences.\"\"\"\nfrom pathlib import Path\n\nimport numpy as np\n\nfrom demosaic.experiments.artifacts import checked,read_json,reference,write_json\n\nROOT = Path(__file__).resolve().parent\nOUTPUT = Path(\"docs/results/scene-full-epoch-v1\")\n\n\ndef summarize(a,b,indices):\n    def samples(v):\n        dots = np.array([s[\"aligned_increment_dot\"]for s in v])\n        power = np.array([s[\"exact_paired_increment_sq\"]for s in v])\n        result = {\"weak_response_percentage_points\":100*dots[indices].sum(1)/power[indices].sum(1)}\n        for metric in (\"increment_RMS_DN16\",\"quiet_RMS_DN16\"):\n            result[metric] = np.array([s[metric]for s in v])[indices].mean(1)\n        return result\n\n    a,b = map(samples,(a,b))\n    return {name:[float((v-b[name])[0]),*[float(x)for x in np.quantile((v-b[name])[1:],[.025,.975])]]\n            for name,v in a.items()}\n\n\ndef run():\n    old,new = (reference(ROOT/f\"review-{step:06d}/pilot/results.json\")for step in (2000,5000))\n    prior,latest = (read_json(checked(item))[\"source_metrics\"]for item in (old,new))\n    indices = np.vstack((np.arange(8),np.random.default_rng(17905).integers(8,size=(10000,8))))\n    results = {}\n    for prior_name in (\"iso400\",\"iso6400\"):\n        results[prior_name] = {}\n        for draw in (\"coupled\",\"independent\"):\n            def group(source):\n                selected = [q for q in source if (q[\"profile\"],q[\"draw\"])==(prior_name,draw)]\n                return {r[\"source\"]:r[\"metrics\"]for r in selected}\n\n            first,second = group(prior),group(latest)\n            assert len(first)==len(second)==8 and set(first)==set(second)\n            ordered = sorted(first)\n\n            def band(src,arm):\n                return [src[key][arm][\"band\"][\"fine\"]for key in ordered]\n\n            opposing = {\n                \"matching_vs_neutral\":(second,\"spatial/matching\",second,\"spatial/neutral\"),\n                \"matching_vs_wrong\":(second,\"spatial/matching\",second,\"spatial/wrong-distant\"),\n                \"matching_vs_local\":(second,\"spatial/matching\",second,\"none\"),\n                \"matching_vs_parent\":(second,\"spatial/matching\",second,\"100k\"),\n                \"matching_vs_V120\":(second,\"spatial/matching\",second,\"V120\"),\n                \"matching_5k_vs_2k\":(second,\"spatial/matching\",first,\"spatial/matching\"),\n            }\n            results[prior_name][draw] = {\n                key:summarize(band(a,an),band(b,bn),indices)\n                for key,(a,an,b,bn) in opposing.items()\n            }\n    write_json(OUTPUT/\"matched-005000-pilot-paired.json\",{\n        \"script\":Path(__file__).read_text(),\"source_002000\":old,\"source_005000\":new,\n        \"method\":\"Paired photo-ID bootstrap, 10,000 resamples. Triples contain full-sample difference and 2.5th and 97.5th percentiles.\",\n        \"fine_band\":results,\n    })\n\n\nif __name__==\"__main__\":\n    run()\n",
