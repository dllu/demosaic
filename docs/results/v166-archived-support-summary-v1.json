    "text": "\"\"\"Predeclared reduction of archived support metadata;no causal intervention or forwards.\"\"\"\nfrom collections import defaultdict\nfrom pathlib import Path\nimport numpy as np\nfrom train_directional_bank_trial import read,ref,save\nrepo=Path('/home/dllu/proj/demosaic');root=repo/'.cache/quality-20261107/V166-common-support-routing-v2'\nreview=read(root/'review-result-v1.json');cases={c['id']:c for c in read(root/'quality-design-v1.json')['observations']};groups=defaultdict(list);collections={};ADC=[]\nfor label,binding in review['collections'].items():\n assert ref(binding['path'])==binding;c=read(binding['path']);assert c['module_before']==c['module_after'] and c['RNG_unchanged']\n collections[label]=binding\n for row in c['observations']:\n  case=cases[row['id']];condition=case.get('present',case.get('variant',{}).get('name',case.get('noise',{}).get('name')))\n  assert 0<=row['support_mean']<=1 and all(np.isfinite(row[k]) for k in ['support_mean','coefficient_correction_RMS','spatial_correction_RMS_DN16'])\n  groups[label,case['kind'],condition,case.get('cohort')].append(row)\n  if case['kind']=='photo' and case.get('cohort')=='adc-photo256':\n   assert ref(row['prediction']['path'])==row['prediction'] and ref(case['parent']['path'])==case['parent']\n   equal=np.array_equal(np.load(row['prediction']['path']),np.load(case['parent']['path']))\n   ADC.append({'method':label,'id':case['id'],'exact_parent':equal})\nsummary=[]\nfor (label,kind,condition,cohort),rows in groups.items():\n values=np.asarray([v['support_mean'] for v in rows]);summary.append({'method':label,'kind':kind,'condition':condition,'cohort':cohort,'cases':len(rows),\n  'support_mean_min_median_p90_max':np.quantile(values,[0,.5,.9,1]).tolist(),'cases_support_mean_below_1e4':int((values<1e-4).sum()),\n  'mean_coefficient_correction_RMS':float(np.mean([v['coefficient_correction_RMS'] for v in rows])),\n  'mean_spatial_correction_RMS_DN16':float(np.mean([v['spatial_correction_RMS_DN16'] for v in rows]))})\noutput=repo/'docs/results/v166-archived-support-summary-v1.json';assert not output.exists()\nsave(output,{'status':'completed-predeclared-archived-metadata-reduction-and-ADC-parent-check','collections':collections,\n 'design':ref(root/'quality-design-v1.json'),'rows_checked':3288,'groups':summary,'ADC_photo_parent_checks':ADC,\n 'source':dict(ref(Path(__file__)),text=Path(__file__).read_text()),'new_neural_forwards':0,'new_noise_draws':0,\n 'scope':'Predeclared diagnostic of support and direct RGB activity. This reduction was frozen before final quality existed. Summarizes scalar mean support and pre-support coefficient/spatial correction RMS already recorded during original actual forwards. Full support maps were not retained,so no independent pixel-level gate reconstruction is claimed. A small gate alongside larger coefficient RMS suggests suppression but does not isolate training causality or measure a trained-path removal. ADC exact-parent checks use actual original arrays. No model,weights,loss or inference changed.'})\nfor g in summary:\n if g['kind']=='mesh' and g['condition'] is True:print(g)\nprint('ADC-photo exact parent',[(m,sum(v['exact_parent'] for v in ADC if v['method']==m),sum(v['method']==m for v in ADC)) for m in collections])\n"
