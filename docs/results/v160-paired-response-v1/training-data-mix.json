    "text": "\"\"\"Summarize actual cached scenes,conditioning and paired-unit coverage.\"\"\"\nfrom collections import Counter\nfrom pathlib import Path\n\nimport numpy as np\nfrom train_directional_bank_trial import read,ref,save\n\nroot=Path('/home/dllu/proj/demosaic/.cache/quality-20261107/V160-paired-response-v1')\ncache=read(root/'cache-result-v2.json');assert len(cache['batches'])==1000\nheldout=set(read(root.parent/'paired-response-data-inspection-v1/inspection-v1.json')['source_preflight']['heldout_photo_ids'])\ndomains=Counter();noises=Counter();photos=[];weak=Counter();units={k:[] for k in ['mesh','weak','photo']}\npaired=ADC=0\nfor row in cache['batches']:\n    m=row['metadata'];domains[m['domain']]+=1\n    adc=m['noise']['shot']==m['noise']['read']==0\n    ADC+=adc;noises['ADC-only' if adc else 'nonzero-sensor-noise']+=1\n    assert len(m['cases'])==4\n    if m['coupled_pairs']:\n        paired+=1;assert m['coupled_pairs']==2\n        units[m['domain']]+=m['sensor']['units_DN16']\n        assert len(m['sensor']['units_DN16'])==len(m['sensor']['increment_mean_variance'])==2\n        for u,v in zip(m['sensor']['units_DN16'],m['sensor']['increment_mean_variance'],strict=True):\n            expected=max(np.sqrt(v),16/65535)*65535\n            assert abs(u-expected)<1e-5*max(1,expected)\n        for case in m['cases'][0::2]:\n            source=case['source']\n            if m['domain']=='photo':\n                assert source['source']['source_id'] not in heldout\n                photos.append(source)\n            if m['domain']=='weak':weak[source['present_recipe']['kind']]+=1\nassert dict(domains)=={'mesh':341,'photo':243,'flat':153,'mixed':156,'weak':107}\nassert paired==691 and ADC==100 and len(photos)==486 and sum(weak.values())==214\nsource_ids=Counter(p['source']['source_id'] for p in photos)\nresult={'status':'completed-actual-cache-metadata-mix','cache':ref(root/'cache-result-v2.json'),\n    'batches':1000,'observations':4000,'domains':dict(domains),'noise_batches':dict(noises),\n    'paired_batches':paired,'pairs':2*paired,'paired_frames':4*paired,'ordinary_frames':4*(1000-paired),\n    'underlying_scene_or_patch_instances':2*paired+4*(1000-paired),\n    'photo_pairs':len(photos),'photo_source_ids':len(source_ids),'photo_source_multiplicity':dict(source_ids),\n    'photo_reduced_contrast_pairs':sum(p['contrast']<1 for p in photos),\n    'photo_full_contrast_pairs':sum(p['contrast']==1 for p in photos),\n    'photo_reviewed_ROI_pairs':sum(p['source']['reviewed_roi_xywh'] is not None for p in photos),\n    'weak_source_kinds':dict(weak),\n    'pair_units_DN16':{k:{'pairs':len(v),'min_median_max':np.quantile(v,[0,.5,1]).tolist(),\n        'floor16_pairs':sum(abs(u-16)<1e-5 for u in v)} for k,v in units.items()},\n    'heldout_photo_ids_excluded':sorted(heldout),\n    'new_forwards':0,'new_noise_draws':0,'source':dict(ref(Path(__file__)),text=Path(__file__).read_text()),\n    'scope':'Counts describe actual fixed cached metadata,not independent scenes or empirical RGB uncertainty. Pair members share geometry/camera and coupled noise. Underlying scene/patch instances may revisit a Commons source. Failed source24 is accounted separately in execution ledger;this manifest contains1000 unique step recipes.'}\noutput=root/'training-data-mix-v1.json';assert not output.exists();save(output,result)\nprint({k:result[k] for k in ['underlying_scene_or_patch_instances','photo_source_ids','photo_reduced_contrast_pairs','photo_reviewed_ROI_pairs','pair_units_DN16']})\n"
