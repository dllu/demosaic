    "text": "\"\"\"Summarize recorded spectral/support/spatial magnitudes,not inferred accuracy.\"\"\"\n\nfrom collections import defaultdict\nfrom pathlib import Path\n\nimport numpy as np\nfrom train_directional_bank_trial import read,ref,save\n\nroot=Path('/home/dllu/proj/demosaic/.cache/quality-20261103/V157-spatial-rgb-v1')\nreview=read(root/'review-result-v1.json')\ncases={c['id']:c for c in read(root/'quality-design-v1.json')['observations']}\ngroups=defaultdict(list)\nfor method,binding in review['collections'].items():\n    assert ref(binding['path'])==binding\n    for row in read(binding['path'])['observations']:\n        c=cases[row['id']]\n        condition=c.get('present',c.get('variant',{}).get('name',c.get('noise',{}).get('name')))\n        groups[method,c['kind'],str(condition),c.get('cohort')].append(row)\nsummaries=[]\nfor (method,kind,condition,cohort),rows in groups.items():\n    summary={'method':method,'kind':kind,'condition':condition,'cohort':cohort,'cases':len(rows)}\n    for field in ['support_mean','coefficient_correction_RMS','spatial_correction_RMS_DN16']:\n        if field not in rows[0]:continue\n        values=np.array([r[field] for r in rows],dtype=np.float64)\n        assert np.isfinite(values).all()\n        summary[field]={'mean':float(values.mean()),'median':float(np.median(values)),\n                        'maximum':float(values.max()),'exact_zero_cases':int((values==0).sum())}\n    summaries.append(summary)\noutput=root/'component-usage-summary-v1.json';assert not output.exists()\nsave(output,{'status':'completed-recorded-auxiliary-scalar-summary','review':ref(root/'review-result-v1.json'),\n    'groups':summaries,'new_forwards':0,'new_noise_draws':0,\n    'source':dict(ref(Path(__file__)),text=Path(__file__).read_text()),\n    'scope':'Recorded FP32 forward auxiliary magnitudes. Spatial/total spectral paths train jointly,so magnitudes do not isolate causal quality or calibrated confidence. Actual target errors and native images remain decisive.'})\nfor row in summaries:\n    if row['kind'] in ['mesh','mixed-quiet','flat']:print(row)\n"
