    "text": "\"\"\"Post-hoc size audit of actual ADC-only photo changes,without inference.\"\"\"\nfrom pathlib import Path\nimport numpy as np\nfrom train_directional_bank_trial import read,ref,save\nrepo=Path('/home/dllu/proj/demosaic');root=repo/'.cache/quality-20261107/V167-bounded-support-v1'\nscores=read(root/'scores-v1.json');cases={c['id']:c for c in read(root/'quality-design-v1.json')['observations']};records=[]\nfor row in scores['rows']:\n if row['kind']!='photo' or row['cohort']!='adc-photo256' or not row['method'].startswith('bounded-support-'):continue\n parent=cases[row['id']]['parent'];assert ref(parent['path'])==parent and ref(row['prediction']['path'])==row['prediction']\n a=np.load(row['prediction']['path']);b=np.load(parent['path']);d=(a.astype(np.float64)-b.astype(np.float64))*65535\n records.append({'method':row['method'],'id':row['id'],'prediction':row['prediction'],'parent':parent,\n  'displacement_RMS_DN16':float(np.sqrt(np.mean(d*d))),'maximum_absolute_displacement_DN16':float(np.abs(d).max()),'changed_RGB_values':int(np.count_nonzero(d)),\n  'RGB_values':int(d.size)})\nassert len(records)==16\ngroups=[]\nfor method in dict.fromkeys(r['method'] for r in records):\n rows=[r for r in records if r['method']==method];assert len(rows)==8\n groups.append({'method':method,'cases':8,'mean_displacement_RMS_DN16':float(np.mean([r['displacement_RMS_DN16'] for r in rows])),\n  'maximum_absolute_displacement_DN16':max(r['maximum_absolute_displacement_DN16'] for r in rows),\n  'changed_RGB_values':sum(r['changed_RGB_values'] for r in rows),'RGB_values':sum(r['RGB_values'] for r in rows)})\noutput=repo/'docs/results/v167-adc-photo-displacement-v1.json';assert not output.exists()\nsave(output,{'status':'completed-post-hoc-original-array-ADC-photo-displacement-audit','scores':ref(root/'scores-v1.json'),\n 'rows':records,'groups':groups,'source':dict(ref(Path(__file__)),text=Path(__file__).read_text()),'new_neural_forwards':0,'new_noise_draws':0,\n 'scope':'Post-hoc diagnostic prompted by non-exact-parent ADC photo outputs. Actual16 original arrays,FP64 displacement from parent in DN16. This is displacement,not target error;target error stays in full fixed scores. Constant RAW tests do not establish ADC photo identity or noisy-flat safety. No weights,loss,training or inference changed.'})\nfor g in groups:print(g)\n"
  },
  "new_neural_forwards": 0,
