    "text": "\"\"\"Share verified immutable completed receipt copies; preserve both paths/bytes.\"\"\"\nfrom pathlib import Path\nfrom datetime import datetime\nfrom zoneinfo import ZoneInfo\nimport hashlib,json,os,stat,shutil,psutil,time\nR=Path.cwd();Q=R/'.cache/quality-20261107'\nindices=['v175-fresh-noise-matching-final-v1.json','v178-phase-evidence-final-v1.json','v180-local-phase-evidence-final-v1.json','v181-flat-spatial-evidence-final-v1.json']\nallowed={Q/n for n in ['V175-fresh-noise-matching-v2','V178-phase-evidence-trial-v1','V180-local-phase-trial-v1','V181-flat-spatial-evidence-trial-v1']}\ndef ref(p):\n p=Path(p).absolute()\n with p.open('rb') as f:h=hashlib.file_digest(f,'sha256').hexdigest()\n return {'path':str(p),'sha256':h}\ndef read(p):return json.loads(Path(p).read_text())\ndef save(p,x):\n with Path(p).open('x') as f:json.dump(x,f,indent=2,allow_nan=False);f.write('\\n')\ndef live(o):\n try:p=psutil.Process(o['pid']);return p.create_time()==o['created'] and p.status() not in [psutil.STATUS_ZOMBIE,psutil.STATUS_DEAD]\n except psutil.NoSuchProcess:return False\ndef observed(p):\n s=p.stat();return {'device':s.st_dev,'inode':s.st_ino,'links':s.st_nlink,'size':s.st_size,'blocks_bytes':s.st_blocks*512,'mtime_ns':s.st_mtime_ns,'uid':s.st_uid,'mode':stat.S_IMODE(s.st_mode)}\nrows=[];owner_checks=[]\nfor root in sorted(allowed):\n for p in root.glob('*-launch-v1.json'):\n  x=read(p)\n  if 'owner' in x:\n   assert not live(x['owner']),(p,x['owner'])\n   owner_checks.append({'launch':ref(p),'owner_observed_terminal':x['owner']})\nfor name in indices:\n index=R/'docs/results'/name;x=read(index);assert x['status'].startswith('completed-')\n for key,pair in x['copies'].items():\n  a,b=Path(pair['original']['path']),Path(pair['public']['path'])\n  if a.parent not in allowed or not b.is_relative_to(R/'docs/results'):continue\n  sa,sb=observed(a),observed(b)\n  if sa['size']<2**20 or sa['links']!=1 or (sa['device'],sa['inode'])==(sb['device'],sb['inode']):continue\n  assert a.is_relative_to(R) and b.is_relative_to(R) and not a.is_symlink() and not b.is_symlink()\n  assert sa['device']==sb['device'] and sa['uid']==sb['uid']==os.getuid() and sa['mode']==sb['mode']\n  assert pair['original']['sha256']==pair['public']['sha256']\n  assert ref(a)==pair['original'] and ref(b)==pair['public']\n  rows.append({'publication':ref(index),'name':key,'original':pair['original'],'public':pair['public'],'before_original':sa,'before_public':sb})\nassert rows\nfree_before=shutil.disk_usage(R).free\nplan={'created_local':datetime.now(ZoneInfo('America/Los_Angeles')).isoformat(),'status':'planned-explicit-completed-public-private-receipt-hardlinks','owner_checks':owner_checks,'rows':rows,'planned_reclaim_allocated_bytes':sum(r['before_original']['blocks_bytes'] for r in rows),'local_free_before':free_before,'source':dict(ref(__file__),text=Path(__file__).read_text()),'scope':'Only >=1MiB private receipt copies of four completed publications,validated against their explicit publiccopy bindings and hashes. Both paths/content remain. No activeV183worker,NNfile,array/checkpoint,originalmedia or externalpath touched. Original inode/mtime may become publiccopy metadata,recorded;receipt bytes and embedded UTC/human dates unchanged. No original/dataz access.'}\nsave(R/'.cache/v183-completed-receipt-hardlink-plan-v1.json',plan)\nfor row in rows:\n a,b=Path(row['original']['path']),Path(row['public']['path']);temporary=a.with_name('.'+a.name+'.v183-hardlink-v1.tmp');assert not temporary.exists()\n assert observed(a)==row['before_original'] and observed(b)==row['before_public']\n os.link(b,temporary);os.replace(temporary,a)\n assert ref(a)==row['original'] and ref(b)==row['public']\n sa,sb=observed(a),observed(b);assert sa['device']==sb['device'] and sa['inode']==sb['inode'] and sa['links']==sb['links']>=2\n row['after_original'],row['after_public']=sa,sb\nfree_after=shutil.disk_usage(R).free\nresult={'status':'pass-completed-receipt-copy-hardlinks-all-paths-and-receipt-bytes-preserved','created_local':datetime.now(ZoneInfo('America/Los_Angeles')).isoformat(),'plan':ref(R/'.cache/v183-completed-receipt-hardlink-plan-v1.json'),'rows':rows,'completed_launch_owners_checked_terminal':len(owner_checks),'pairs':len(rows),'logical_bytes_shared':sum(r['before_original']['size'] for r in rows),'previous_private_allocated_bytes':sum(r['before_original']['blocks_bytes'] for r in rows),'local_free_before':free_before,'local_free_after':free_after,'observed_net_free_change_bytes':free_after-free_before,'all_original_public_hashes_exact':True,'source':dict(ref(__file__),text=Path(__file__).read_text()),'scope':plan['scope']+' Netfreechange may include concurrent unrelated activity;previous allocation is separately recorded. No receipt/data path removed.'}\nsave(R/'docs/results/v183-completed-receipt-hardlink-recovery-v1.json',result)\nprint('PASS',len(rows),'explicit completedreceiptpairs',result['previous_private_allocated_bytes']/2**20,'MiB priorprivateallocation;netlocalfreechange',(free_after-free_before)/2**20,'MiB;currentfree',free_after/2**30,'GiB')\n"
