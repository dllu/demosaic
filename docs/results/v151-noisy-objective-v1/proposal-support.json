    "sha256": "ab94c8b28448b2cf4b361dbb87af3cda654371c9a2d0dd9f10779dc2a2b8d877",
    "text": "\"\"\"Reduce archived support/proposal diagnostics without another model call.\"\"\"\n\nimport math\nfrom collections import defaultdict\nfrom pathlib import Path\n\nimport numpy as np\nfrom train_directional_bank_trial import read, ref, save\n\nroot = Path('/home/dllu/proj/demosaic/.cache/quality-20261103/V151-noisy-objective-v1')\ncases = {c['id']: c for c in read(root / 'quality-design-v1.json')['observations']}\nreview = read(root / 'review-result-v1.json')\ngroups = []\nchecks = 0\nfor label, binding in review['collections'].items():\n    assert ref(binding['path']) == binding\n    collected = defaultdict(list)\n    for observation in read(binding['path'])['observations']:\n        case = cases[observation['id']]\n        collected[case['kind'], case.get('present')].append(observation)\n        if case['kind'] == 'mesh':\n            collected['mesh-all', None].append(observation)\n    for (kind, present), rows in collected.items():\n        group = {'method': label, 'kind': kind, 'present': present, 'cases': len(rows)}\n        for field in ['support_mean', 'coefficient_correction_RMS']:\n            values = [row[field] for row in rows]\n            assert all(math.isfinite(v) and v >= 0 for v in values)\n            mean = math.fsum(values) / len(values)\n            assert abs(mean - float(np.mean(np.array(values, dtype=np.float64)))) < 1e-15\n            group[field] = mean\n            group[field + '_minimum'] = min(values)\n            group[field + '_maximum'] = max(values)\n            checks += 1\n        groups.append(group)\nsave(root / 'proposal-support-summary-v1.json', {\n    'status': 'completed-archived-auxiliary-reductions',\n    'review': ref(root / 'review-result-v1.json'),\n    'source': dict(ref(Path(__file__)), text=Path(__file__).read_text()),\n    'groups': groups, 'independent_mean_checks': checks,\n    'new_forwards': 0, 'new_noise_draws': 0,\n    'scope': 'Unweighted means of archived per-observation spatial support means and pre-support coefficient-correction RMS. NumPy64 means independently agree with math.fsum. Mean support is not calibrated detection or evidence of spatial selectivity. Coefficient RMS is not final RGB error or a hallucination metric.'})\nfor row in groups:\n    if row['kind'] in ['mesh-all', 'mesh']:\n        print(row['method'], row['kind'], row['present'], row['support_mean'], row['coefficient_correction_RMS'])\n"
  },
