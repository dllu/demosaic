  "source_decisions": [
    {
      "id": "26bd4586d99c22b4f9fb8ff1f2b37ced46a11147",
      "title": "File:Fishing net shop at Dhap Sultanganj Hat.jpg",
      "author": "ROCKY",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0",
      "page_url": "https://commons.wikimedia.org/wiki/File:Fishing_net_shop_at_Dhap_Sultanganj_Hat.jpg",
      "decision": "retain-ordinary",
      "specialized_region_admitted": false,
      "reason": "Retain ordinary net-shop photograph. Native1024 shows physical fine mesh with visible alias/moire and processed-looking repeated edges. Area8 local64 has only5/16 blocks below5%, full25622/255 eligible. Do not add a specialized clean weak-detail annotation or certify artifact-free net structure."
    },
    {
      "id": "e3409a5f734a0281301507b82812449d9354b37e",
      "title": "File:Fishing net 2 Heraklion.jpg",
      "author": "Jebulon",
      "license": "CC0",
      "license_url": "http://creativecommons.org/publicdomain/zero/1.0/deed.en",
      "page_url": "https://commons.wikimedia.org/wiki/File:Fishing_net_2_Heraklion.jpg",
      "decision": "retain-ordinary",
      "specialized_region_admitted": false,
      "reason": "Retain real yellow fishing nets, ropes and floats. Strong saturated texture and repeated physical strands are not a graphic. No pristine/low-contrast claim or extra specialized region."
    },
    {
      "id": "e7e5ecad59c2976f8a43c464fc14ec6b466f970c",
      "title": "File:Cygnus feathers.jpg",
      "author": "Basile Morin",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0",
      "page_url": "https://commons.wikimedia.org/wiki/File:Cygnus_feathers.jpg",
      "decision": "retain-ordinary",
      "specialized_region_admitted": true,
      "reason": "Admit one pale swan-plumage region: native1024 resolves coherent barbs and overlapping feather tips; area8 retains faint repeated structure. Local64 has11/16 and full256186/256 eligible fine-band blocks below5% before augmentation. The context contains stronger boundaries too; no source-wide noiseless claim."
    },
    {
      "id": "ea8724decfd375e407a345ee8acee451c2316ed9",
      "title": "File:Close-up photograph of swan feathers letting sunlight through.jpg",
      "author": "Basile Morin",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0",
      "page_url": "https://commons.wikimedia.org/wiki/File:Close-up_photograph_of_swan_feathers_letting_sunlight_through.jpg",
      "decision": "retain-ordinary",
      "specialized_region_admitted": false,
      "reason": "Retain ordinary backlit swan feathers with coherent physical barbs. Similar subject/material to admitted plumage; avoid adding another near-looking region merely to raise the count. Capture identity/independence is not established by titles."
    },
    {
      "id": "d43d1127abbb9ae378295578a2b70985ba924b0c",
      "title": "File:Peacock feather close-up.jpg",
      "author": "Mister rf",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0",
      "page_url": "https://commons.wikimedia.org/wiki/File:Peacock_feather_close-up.jpg",
      "decision": "retain-ordinary",
      "specialized_region_admitted": false,
      "reason": "Retain physical iridescent peacock feather. Strong color and specular contrast are natural-looking, not grounds for a graphic exclusion. No low-contrast annotation."
    },
    {
      "id": "7d6bfee7b2a11a42ba614b77b234966f007510de",
      "title": "File:Feather on Grass.jpg",
      "author": "Prosthetic Head",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0",
      "page_url": "https://commons.wikimedia.org/wiki/File:Feather_on_Grass.jpg",
      "decision": "retain-ordinary",
      "specialized_region_admitted": false,
      "reason": "Retain feather on real grass. Native1024 resolves regular barbs, quill and debris, but the proposed local64 has0/16 blocks below5% and full256 has192/256 at least20%. Do not label this predominantly high-contrast context weak merely because it contains fine lines."
    },
    {
      "id": "f6208dd464a09062dcb17469b85c7a48e843fe63",
      "title": "File:Trichonephila plumipes, Pacific Golden Orb Weaving Spider, Sydney.jpg",
      "author": "Stu's Images",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0",
      "page_url": "https://commons.wikimedia.org/wiki/File:Trichonephila_plumipes,_Pacific_Golden_Orb_Weaving_Spider,_Sydney.jpg",
      "decision": "retain-ordinary",
      "specialized_region_admitted": false,
      "reason": "Retain real spider, body texture and thin web against natural bokeh. Focus variation is not an automatic photo-quality exclusion; no specialized weak-context selection."
    },
    {
      "id": "3c1cb4c2c34713c001bd0d839749a295f8ae6afc",
      "title": "File:Fence next to Christopher Hut, St James Walkway, New Zealand (52).jpg",
      "author": "Michal Klajban",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0",
      "page_url": "https://commons.wikimedia.org/wiki/File:Fence_next_to_Christopher_Hut,_St_James_Walkway,_New_Zealand_(52).jpg",
      "decision": "retain-ordinary",
      "specialized_region_admitted": false,
      "reason": "Retain real weathered fence post and wires. Native foreground texture remains coherent, while distant scene softness is intentional depth of field. No sharp full-scene or weak-mesh claim."
    }
